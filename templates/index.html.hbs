<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ appName }}&thinsp;&ndash;&thinsp;{{ tagline }}</title>
    <meta name="description" content="Fifty-seven free logic puzzles to play in your browser, with hints that explain the next move instead of just making it. Works offline, with touch, mouse or keyboard.">
    <meta name="application-name" content="{{ appName }}">
  {{#if canonicalUrl}}
    <link rel="canonical" href="{{ canonicalUrl }}">
  {{/if}}
    <link rel="stylesheet" href="/src/css/home.css">
    <script nomodule>{{{ noModuleHeadScript }}}</script>
    <script>{{{ colorSchemeInitScript }}}</script>
    <script type="module" crossorigin src="{{ preflightSrc }}"></script>
    <script type="module" src="/src/home-page.ts"></script>
  </head>
  <body>
    <home-screen>
      <header slot="header">
        <div part="header-inner">
          <img class="logo" src="/favicon.svg" alt="" role="presentation">
          <div class="title">
            <h1 translate="no">{{ appName }}</h1>
          </div>
          <div class="subtitle">{{ tagline }}</div>
          <div class="controls">
            <a class="help-button" href="help/">
              <img src="/node_modules/lucide-static/icons/circle-question-mark.svg" alt="">Help</a>
          </div>
        </div>
      </header>

      <section slot="intro">
        <p>Fifty-seven logic puzzles, free and endlessly generated — and most of
          them will show you the next move <em>and explain why</em>. Plays with
          touch, mouse or keyboard, and works
          <a href="help/install">offline</a>.</p>
      </section>

      <noscript>
        <section class="warning">
          ⚠️ {{ appName }} needs JavaScript. Turn it on in your browser to play.
        </section>
      </noscript>

      <footer slot="footer">
        <div>Credits, licenses and the privacy notes are in the
          <a href="{{ repoUrl }}">source code</a>.
        </div>
        <div><small>Some puzzles are known elsewhere by names that are
          trademarks of their owners. Naming them here implies no affiliation
          or endorsement.</small></div>
      </footer>
    </home-screen>
    {{{ analytics_html }}}
  </body>
</html>
