+/**
+ * One leg of the what-if path: an arrow from cell `a`'s centre to cell `b`'s.
+ *
+ * Shortened at both ends so it starts and finishes clear of the marks it
+ * connects, and drawn *between* tiles rather than inside one — which is why it
+ * cannot live in {@link drawTile} and gets its own pass after the tile loop.
+ *
+ * Consecutive links are **not** necessarily adjacent: the chain re-scans the
+ * board row-major after each forcing, so a leg can jump across the grid. That
+ * is a true fact about the deduction and the arrow is allowed to say it.
+ */
+function drawChainArrow(
+  dr: GameDrawing,
+  ts: number,
+  b: number,
+  a: { x: number; y: number },
+  z: { x: number; y: number },
+  col: number,
+): void {
+  const cx = (c: { x: number; y: number }) => c.x * ts + b + (ts >> 1);
+  const cy = (c: { x: number; y: number }) => c.y * ts + b + (ts >> 1);
+  const x1 = cx(a);
+  const y1 = cy(a);
+  const x2 = cx(z);
+  const y2 = cy(z);
+  const dx = x2 - x1;
+  const dy = y2 - y1;
+  const len = Math.hypot(dx, dy);
+  if (len < 1) return;
+  const ux = dx / len;
+  const uy = dy / len;
+  // Clear the mark at each end (the what-if square is ts/3 across).
+  const clear = Math.min(ts * 0.34, len / 2 - 1);
+  const sx = Math.round(x1 + ux * clear);
+  const sy = Math.round(y1 + uy * clear);
+  const ex = Math.round(x2 - ux * clear);
+  const ey = Math.round(y2 - uy * clear);
+  const thick = Math.max(2, Math.floor(ts / 14));
+  dr.drawLine({ x: sx, y: sy }, { x: ex, y: ey }, col, thick);
+
+  // Head at the destination: two barbs, sized off the tile so it stays legible
+  // when a leg is only one cell long.
+  const head = Math.max(4, Math.floor(ts / 5));
+  const px = -uy;
+  const py = ux;
+  for (const s of [1, -1]) {
+    dr.drawLine(
+      { x: ex, y: ey },
+      {
+        x: Math.round(ex - ux * head + s * px * head * 0.55),
+        y: Math.round(ey - uy * head + s * py * head * 0.55),
+      },
+      col,
+      thick,
+    );
+  }
+}
