# IDE
# Generated by `openspec init`/`update` — regenerate rather than commit, so the
# pinned CLI version is the single source of what they say.
.claude/commands/opsx/
.claude/skills/openspec-*/
.claude/scheduled_tasks.lock
.vscode/
.antigravitycli/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules/
/dev-dist/
/dist/
/dist-server/
/dist-ssr/
*.local

# Generated by rollup-plugin-visualizer
/dist-stats*.html

# Generated by preflight build
/public/preflight/

# Icons under /src/assets/icons/ are committed snapshots. To produce the two
# PNGs a new puzzle needs, open it with ?screenshot in the dev server and use
# "Capture icons" (src/puzzle/icon-capture.ts); see openspec/specs/puzzle-icons.
# (There is no scripts/build-icons.sh — the GTK screenshot pipeline it named was
# deleted by drop-icon-generation.)

# TypeScript incremental build info (from `tsc -b`)
*.tsbuildinfo

# Other scratch directories
/patches/

# Generated by playwright-cli skill (browser session snapshots, console logs)
/.playwright-cli/

# Stryker's per-mutant sandbox copies of the tree (audit-test-suite-strength).
# The audit's *findings* are committed under the change; its scratch is not.
/.stryker-tmp/

# Screenshots dropped at the repo root by a browser check. `.playwright-cli/`
# above covers the skill's own snapshots, but `playwright-cli screenshot
# --filename=x.png` resolves against the CWD and lands here — which has now
# happened twice, once reaching a commit (`darkcheck.png`, removed 2026-09-04).
# Root-level only: the real PNGs live under `public/` and `src/assets/icons/`,
# and this must never hide one of those. Write browser output to the session
# scratchpad instead.
/*.png
