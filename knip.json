{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/preflight.ts",
    "src/color-scheme-init.ts",
    "src/home-page.ts",
    "src/puzzle-page.ts",
    "vite-plugins/*.ts",
    "scripts/*.mjs",
    "src/engine/index.ts",
    "src/engine/grid/index.ts"
  ],
  "project": ["src/**/*.ts", "vite-plugins/**/*.ts", "scripts/**/*.mjs"],
  "ignoreDependencies": ["jscpd", "madge"],
  "ignore": ["src/asset-integrity.test.ts", "src/module-layering.test.ts"],
  "vitest": {
    "entry": [
      "**/*.test.ts",
      "!src/asset-integrity.test.ts",
      "!src/module-layering.test.ts"
    ]
  },
  "ignoreExportsUsedInFile": true,
  "tags": ["-public"]
}
