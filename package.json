{
  "name": "puzzles-ts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "typecheck": "tsc -b --noEmit",
    "pretest": "sh scripts/reap-orphaned-workers.sh",
    "test": "vitest",
    "pretest:run": "sh scripts/reap-orphaned-workers.sh",
    "test:run": "vitest run --passWithNoTests",
    "diff": "vitest run --passWithNoTests -c scripts/checks/diff.vitest.config.mts",
    "gate": "sh scripts/gate.sh",
    "test:slow": "PUZZLES_SLOW_TESTS=1 vitest run --passWithNoTests",
    "test:shuffle": "vitest run --passWithNoTests --sequence.shuffle.files=true",
    "prepare": "husky",
    "metrics": "sh scripts/metrics.sh",
    "mutation": "rm -rf .stryker-tmp && stryker run scripts/stryker.config.mjs",
    "probe": "node scripts/feedback-probe.mjs"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.5.0",
    "@lit-labs/observers": "^2.1.0",
    "@lit-labs/signals": "^0.3.0",
    "@lit/context": "^1.1.6",
    "@material-design-icons/svg": "^0.14.15",
    "@sentry/browser": "^10.49.0",
    "colorjs.io": "^0.7.1",
    "comlink": "^4.4.2",
    "dexie": "^4.4.2",
    "lit": "^3.3.2",
    "lucide-static": "^1.8.0",
    "signal-utils": "^0.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.12",
    "@lit/reactive-element": "^2.1.2",
    "@mdit/plugin-attrs": "^1.1.1",
    "@mdit/plugin-icon": "^1.0.2",
    "@sentry/vite-plugin": "^5.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@vite-pwa/assets-generator": "^1.0.2",
    "fake-indexeddb": "^6.2.5",
    "handlebars": "^4.7.9",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "madge": "^8.0.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.0",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tinyglobby": "^0.2.17",
    "typescript": "~7.0.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.1.6",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "qs": "^6.15.3",
    "serialize-javascript": "^7.0.5",
    "sharp": "^0.35.3"
  }
}
